{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "noImplicitAny": true,
    "sourceMap": true,
    "outDir": "../dist-electron",
    "baseUrl": ".",
    "paths": {
      "*": ["node_modules/*"]
    },
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "main.ts",
    "preload.ts"
  ]
}