{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* FIX: Enable Interop for 'path' imports */
    "esModuleInterop": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* PATH ALIASES */
    "baseUrl": "./",
    "paths": {
      "@app/*": ["src/app/*"],
      "@core/*": ["src/core/*"],
      "@spatial/*": ["src/modules/spatial/*"],
      "@enterprise/*": ["src/modules/enterprise/*"],
      "@productivity/*": ["src/modules/productivity/*"],
      "@intelligence/*": ["src/modules/intelligence/*"],
      "@assets/*": ["src/assets/*"]
    }
  },
  /* FIX: Remove "electron" from here. It has its own config. */
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}